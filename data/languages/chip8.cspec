<?xml version="1.0" encoding="UTF-8"?>

<compiler_spec>

    <!-- CHIP-8 stack uses normal RAM, not a dedicated stack space -->
    <stackpointer register="SP" growth="positive"/>

    <!-- Default calling convention (mostly unused for CHIP-8) -->
    <default_proto>
        <prototype name="default" extrainput="0" stackshift="0"/>
    </default_proto>

</compiler_spec>

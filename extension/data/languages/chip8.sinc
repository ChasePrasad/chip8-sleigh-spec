# Files for reference:
# Sleigh Specification: https://ghidra.re/ghidra_docs/languages/html/sleigh_tokens.html
# CHIP-8 Specification: http://devernay.free.fr/hacks/chip8/C8TECH10.HTM#3.0

# --------------------------------Token definitions--------------------------------
define token instr(16)
  op     = (12,15)    # top nibble for opcode identification
  nnn    = (0,11)     # addr, 12 bit value
  n      = (0,3)      # 4 bit value, lowest 4 bits of instruction
  x      = (8,11)     # lower 4 bits of the high byte
  y      = (4,7)      # upper 4 bits of the low byte
  kk     = (0,7)      # 8 bit value, lowest 8 bits
;

# --------------------------------Attach statements--------------------------------
attach variables [ x y ] [ V0 V1 V2 V3 V4 V5 V6 V7 V8 V9 VA VB VC VD VE VF ];


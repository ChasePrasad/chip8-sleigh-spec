# Define endianness and alignment
define endian=big;
define alignment=2;

#--------------------------------------------------------------------
# Token definitions (from chip8.sinc)
#--------------------------------------------------------------------
define token instr(16)
  op     = (12,15)
  nnn    = (0,11)
  n      = (0,3)
  x      = (8,11)
  y      = (4,7)
  kk     = (0,7)
;

#--------------------------------------------------------------------
# Memory Space Definition
#--------------------------------------------------------------------
define space ram      type=ram_space      size=2  default;
define space register type=register_space size=1;

#--------------------------------------------------------------------
# Register Space Definition
#--------------------------------------------------------------------
define register offset=0x00 size=1 [
  V0 V1 V2 V3 V4 V5 V6 V7 V8 V9 VA VB VC VD VE VF
];

define register offset=0x10 size=2 [ I ];
define register offset=0x12 size=2 [ PC ];
define register offset=0x14 size=1 [ SP ];
define register offset=0x15 size=1 [ DT ];        # Delay timer
define register offset=0x16 size=1 [ ST ];        # Sound timer
define register offset=0x18 size=1 [ KEY ];
define register offset=0x1A size=2 [ DISPLAY ];

#--------------------------------------------------------------------
# Attach statements
#--------------------------------------------------------------------
attach variables [ x y ] [ V0 V1 V2 V3 V4 V5 V6 V7 V8 V9 VA VB VC VD VE VF ];


#--------------------------------------------------------------------
# Instructions (Cher's CHIP-8 Subset)
#--------------------------------------------------------------------

# 0nnn - SYS addr (treated as NOP in modern interpreters) - do nothing

# 2nnn - CALL addr
:CALL nnn is op=0x2 & nnn {
  local returnAddr:2 = inst_next;
  local stackOffset:2 = zext(SP) * 2;
  SP = SP + 1;
  *[ram]:2 stackOffset = returnAddr;
  local addr:2 = nnn;
  call [addr];
}

# Bnnn - JP V0, addr
:"JP V0,"nnn is op=0xB & nnn {
  local target:2 = nnn + zext(V0);
  goto [target];
}

:"LD I",nnn is op=0xA & nnn {
  I = nnn;
}

:"LD B",x is op=0xF & x & kk=0x33 {
  local value:1 = x;
  local hundreds:1 = value / 100;
  local tens:1 = (value / 10) % 10;
  local ones:1 = value % 10;
  local i_addr:2 = I;
  *[ram]:1 i_addr = hundreds;
  *[ram]:1 (i_addr + 1) = tens;
  *[ram]:1 (i_addr + 2) = ones;
}

:LD x,"DT" is op=0xF & x & kk=0x07 {
  x = DT;
}

:LD x,"K" is op=0xF & x & kk=0x0A {
  x = KEY;
}

:SUB x,y is op=0x8 & x & y & n=0x5 {
  local borrow:1 = (x < y);
  VF = 1 - borrow;
  x = x - y;
}

:SUBN x,y is op=0x8 & x & y & n=0x7 {
  local borrow:1 = (y < x);
  VF = 1 - borrow;
  x = y - x;
}

:OR x,y is op=0x8 & x & y & n=0x1 {
  x = x | y;
}

:AND x,y is op=0x8 & x & y & n=0x2 {
  x = x & y;
}

:CLS is op=0x0 & nnn=0x0E0 {
  DISPLAY = 0;
}

:DRW x,y,n is op=0xD & x & y & n {
  local xCoord:1 = x & 0x3F;
  local yCoord:1 = y & 0x1F;
  VF = 0;
}


#--------------------------------------------------------------------
# Instructions (Murali's CHIP-8 Subset)
#--------------------------------------------------------------------
# 00EE - RET
:RET is op=0x0 & nnn=0xEE {
    local stackOffset:2 = zext(SP) * 2;
    local addr:2 = *[ram]:2 stackOffset;
    SP = SP - 1;
    return [addr];
}

# 3xkk - SE Vx, byte
:SE x,kk is op=0x3 & x & kk {
    if (x == kk) goto inst_next;
}

# 5xy0 - SE Vx, Vy
:SE x,y is op=0x5 & x & y & n=0x0 {
    if (x == y) goto inst_next;
}

# Ex9E - SKP Vx
:SKP x is op=0xE & x & kk=0x9E {
    local keyPressed:1 = (KEY == x);
    if (keyPressed) goto inst_next;
}

# 6xkk - LD Vx, byte
:LD x,kk is op=0x6 & x & kk {
    x = kk;
}

# 8xy0 - LD Vx, Vy
:LD x,y is op=0x8 & x & y & n=0x0 {
    x = y;
}

# Fx55 - LD [I], Vx
:LD "[I]",x is op=0xF & x & kk=0x55 {
    *[ram]:1 (I + 0) = V0;
    if (x >= 1) goto <r1>; goto <done>;
    <r1> *[ram]:1 (I + 1) = V1;
    if (x >= 2) goto <r2>; goto <done>;
    <r2> *[ram]:1 (I + 2) = V2;
    if (x >= 3) goto <r3>; goto <done>;
    <r3> *[ram]:1 (I + 3) = V3;
    if (x >= 4) goto <r4>; goto <done>;
    <r4> *[ram]:1 (I + 4) = V4;
    if (x >= 5) goto <r5>; goto <done>;
    <r5> *[ram]:1 (I + 5) = V5;
    if (x >= 6) goto <r6>; goto <done>;
    <r6> *[ram]:1 (I + 6) = V6;
    if (x >= 7) goto <r7>; goto <done>;
    <r7> *[ram]:1 (I + 7) = V7;
    if (x >= 8) goto <r8>; goto <done>;
    <r8> *[ram]:1 (I + 8) = V8;
    if (x >= 9) goto <r9>; goto <done>;
    <r9> *[ram]:1 (I + 9) = V9;
    if (x >= 10) goto <r10>; goto <done>;
    <r10> *[ram]:1 (I + 10) = VA;
    if (x >= 11) goto <r11>; goto <done>;
    <r11> *[ram]:1 (I + 11) = VB;
    if (x >= 12) goto <r12>; goto <done>;
    <r12> *[ram]:1 (I + 12) = VC;
    if (x >= 13) goto <r13>; goto <done>;
    <r13> *[ram]:1 (I + 13) = VD;
    if (x >= 14) goto <r14>; goto <done>;
    <r14> *[ram]:1 (I + 14) = VE;
    if (x >= 15) goto <r15>; goto <done>;
    <r15> *[ram]:1 (I + 15) = VF;
    <done>
}

# Fx65 - LD Vx, [I]
:LD x,"[I]" is op=0xF & x & kk=0x65 {
    V0 = *[ram]:1 (I + 0);
    if (x >= 1) goto <r1>; goto <done>;
    <r1> V1 = *[ram]:1 (I + 1);
    if (x >= 2) goto <r2>; goto <done>;
    <r2> V2 = *[ram]:1 (I + 2);
    if (x >= 3) goto <r3>; goto <done>;
    <r3> V3 = *[ram]:1 (I + 3);
    if (x >= 4) goto <r4>; goto <done>;
    <r4> V4 = *[ram]:1 (I + 4);
    if (x >= 5) goto <r5>; goto <done>;
    <r5> V5 = *[ram]:1 (I + 5);
    if (x >= 6) goto <r6>; goto <done>;
    <r6> V6 = *[ram]:1 (I + 6);
    if (x >= 7) goto <r7>; goto <done>;
    <r7> V7 = *[ram]:1 (I + 7);
    if (x >= 8) goto <r8>; goto <done>;
    <r8> V8 = *[ram]:1 (I + 8);
    if (x >= 9) goto <r9>; goto <done>;
    <r9> V9 = *[ram]:1 (I + 9);
    if (x >= 10) goto <r10>; goto <done>;
    <r10> VA = *[ram]:1 (I + 10);
    if (x >= 11) goto <r11>; goto <done>;
    <r11> VB = *[ram]:1 (I + 11);
    if (x >= 12) goto <r12>; goto <done>;
    <r12> VC = *[ram]:1 (I + 12);
    if (x >= 13) goto <r13>; goto <done>;
    <r13> VD = *[ram]:1 (I + 13);
    if (x >= 14) goto <r14>; goto <done>;
    <r14> VE = *[ram]:1 (I + 14);
    if (x >= 15) goto <r15>; goto <done>;
    <r15> VF = *[ram]:1 (I + 15);
    <done>
}

# Fx1E - ADD I, Vx
:ADD "I",x is op=0xF & x & kk=0x1E {
    I = I + zext(x);
}

# 8xy6 - SHR Vx
:SHR x is op=0x8 & x & y=0x0 & n=0x6 {
    VF = x & 0x1;
    x = x >> 1;
}

# 8xyE - SHL Vx
:SHL x is op=0x8 & x & y=0x0 & n=0xE {
    VF = (x >> 7) & 0x1;
    x = x << 1;
}

#--------------------------------------------------------------------
# Instructions (Chase's CHIP-8 Subset)
#--------------------------------------------------------------------

# 1nnn - JP addr
:JP nnn is op=0x1 & nnn {
  local addr:2 = nnn;
  goto [addr];
}

# 4xkk - SNE Vx, byte
:SNE x,kk is op=0x4 & x & kk {
  if (x != kk) goto inst_next;
}

# 9xy0 - SNE Vx, Vy
:SNE x,y is op=0x9 & x & y & n=0x0 {
  if (x != y) goto inst_next;
}

# ExA1 - SKNP Vx
:SKNP x is op=0xE & x & kk=0xA1 {
  local keyNotPressed:1 = (KEY != x);
  if (keyNotPressed) goto inst_next;
}

# Fx15 - LD DT, Vx
:LD "DT",x is op=0xF & x & kk=0x15 {
  DT = x;
}

# Fx18 - LD ST, Vx
:LD "ST",x is op=0xF & x & kk=0x18 {
  ST = x;
}

# Fx29 - LD F, Vx
:LD "F",x is op=0xF & x & kk=0x29 {
  local digit:2 = zext(x) * 5;
  I = digit;
}

# 7xkk - ADD Vx, byte
:ADD x,kk is op=0x7 & x & kk {
  x = x + kk;
}

# 8xy4 - ADD Vx, Vy
:ADD x,y is op=0x8 & x & y & n=0x4 {
  local sum:2 = zext(x) + zext(y);
  VF = zext(sum > 0xFF);
  x = sum:1;
}

# 8xy3 - XOR Vx, Vy
:XOR x,y is op=0x8 & x & y & n=0x3 {
  x = x ^ y;
}

# To be used in Cxkk - RND Vx, byte
define pcodeop random;

# Cxkk - RND Vx, byte
:RND x,kk is op=0xC & x & kk {
  local rand:1 = random();
  x = rand & kk;
}